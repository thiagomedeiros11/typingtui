{
	"name": "typingtui",
	"version": "0.0.0",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "prettier --check . && xo && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"ink": "^7.1.1",
		"meow": "^14.1.0",
		"react": "^19.3.0"
	},
	"devDependencies": {
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/react": "^19.3.0",
		"ava": "^8.0.1",
		"chalk": "^5.2.0",
		"eslint-plugin-react": "^7.32.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"ink-testing-library": "^3.0.0",
		"prettier": "^3.9.6",
		"ts-node": "^10.9.1",
		"tsx": "^4.23.13",
		"typescript": "^5.8.3",
		"xo": "^2.0.2"
	},
	"ava": {
		"extensions": [
			"ts",
			"tsx"
		],
		"nodeArguments": [
			"--loader=ts-node/esm"
		]
	}
}
